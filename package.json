{
  "name": "dsh-dafeiyu-patrol",
  "version": "0.6.3",
  "description": "鲸声守望：辅助发现不合理讨论，共同维护讨论与创作环境",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./agent": "./src/agent.js",
    "./client": "./ui/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src",
    "ui",
    "evaluation",
    "docs",
    "LICENSE",
    "cordis.patch.yml",
    "README.md",
    "locale",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "node scripts/dev.js",
    "pack:plugin": "node scripts/pack.js",
    "dev:patch": "node scripts/dev-patch.js"
  },
  "engines": {
    "node": ">=22",
    "dsh": "0.2.0-rc.2"
  },
  "dependencies": {
    "playwright-core": "^1.58.0",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "license": "MIT",
  "icon": "./ui/icon.svg",
  "repository": {
    "type": "git",
    "url": "https://github.com/KitlingKittyTiger/dsh-whale-watch.git"
  },
  "homepage": "https://github.com/KitlingKittyTiger/dsh-whale-watch#readme",
  "bugs": {
    "url": "https://github.com/KitlingKittyTiger/dsh-whale-watch/issues"
  }
}
